<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/main_navigation"
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:background="#0B1829"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="♪"
            android:textColor="#6EE7F2"
            android:textSize="25sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="首页"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_display"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="显示"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_lyrics"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="歌词"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_system"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="5dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="系统"
            android:textAllCaps="false" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="26dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/main_toolbar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/main_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LYRICS · COMPANION"
                android:textColor="#6EE7F2"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/main_section_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="5dp"
                android:paddingBottom="3dp"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/main_section_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#A9B6C8"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/main_page_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
