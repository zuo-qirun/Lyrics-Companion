<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 21+ keeps the wide-tracked eyebrow label; letterSpacing is unavailable on API 19. -->
    <style name="TextAppearance.LC.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/lc_primary</item>
    </style>
</resources>
