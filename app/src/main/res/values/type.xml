<resources>
    <!--
        Typography scale for the control surface. Sizes stay close to the previous design
        (13-16sp rows, 24sp screen headings) so in-car glanceability is unchanged while the
        Material 3 type roles provide consistent letter spacing and weights.
    -->

    <style name="TextAppearance.LC.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/lc_primary</item>
    </style>

    <style name="TextAppearance.LC.SectionLabel" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/lc_primary</item>
    </style>

    <style name="TextAppearance.LC.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/lc_on_surface</item>
    </style>

    <style name="TextAppearance.LC.ScreenDescription" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/lc_on_surface_variant</item>
    </style>

    <style name="TextAppearance.LC.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/lc_on_surface</item>
    </style>

    <style name="TextAppearance.LC.ToolbarSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/lc_on_surface_variant</item>
    </style>

    <style name="TextAppearance.LC.RowTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/lc_on_surface</item>
    </style>

    <style name="TextAppearance.LC.RowSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/lc_on_surface_variant</item>
    </style>

    <style name="TextAppearance.LC.Value" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lc_primary</item>
    </style>

    <style name="TextAppearance.LC.Note" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/lc_on_surface_variant</item>
    </style>

    <style name="TextAppearance.LC.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/lc_on_surface</item>
    </style>

    <style name="TextAppearance.LC.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>
</resources>
