<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_background"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/main_toolbar"
                style="@style/Widget.LC.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:subtitle="@string/main_subtitle"
                app:title="@string/main_brand" />

            <TextView
                android:id="@+id/main_eyebrow"
                style="@style/TextAppearance.LC.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_eyebrow" />

            <TextView
                android:id="@+id/main_section_heading"
                style="@style/TextAppearance.LC.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="5dp"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/main_section_description"
                style="@style/TextAppearance.LC.ScreenDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/main_page_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/main_navigation"
        style="@style/Widget.LC.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/main_navigation" />
</LinearLayout>
