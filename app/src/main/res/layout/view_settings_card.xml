<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.LC.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/lc_card_gap">

    <LinearLayout
        android:id="@+id/settings_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/lc_card_padding_horizontal"
        android:paddingTop="@dimen/lc_card_padding_top"
        android:paddingEnd="@dimen/lc_card_padding_horizontal"
        android:paddingBottom="@dimen/lc_card_padding_bottom" />
</com.google.android.material.card.MaterialCardView>
