HOST=0.0.0.0
PORT=8790
PUBLIC_BASE_URL=https://lyrics-companion.zuoqirun.top
AUTO_SYNC=1
SYNC_INTERVAL_MS=300000
ONLINE_TTL_MS=120000
FEEDBACK_INTERVAL_MS=60000
# STATE_DIR=/opt/lyrics-companion/update_server/state

GITHUB_REPO=zuo-qirun/Lyrics-Companion
# Public repositories normally do not require a token.
# GITHUB_TOKEN=github_pat_xxx
RELEASE_TAG=latest
ASSET_PATTERN=^lyrics-companion-.*\.apk$
MANIFEST_ASSET=release-update.json
CHANGELOG_ASSET=CHANGELOG.md
HISTORY_RELEASE_LIMIT=20
